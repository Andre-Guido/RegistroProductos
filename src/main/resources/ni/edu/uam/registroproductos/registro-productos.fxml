<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="460.0" prefWidth="690.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registroproductos.controller.ProductoController">
   <children>
      <BorderPane layoutX="13.0" layoutY="10.0" prefHeight="440.0" prefWidth="660.0">
         <top>
            <Label alignment="CENTER" text="Registro de productos" BorderPane.alignment="CENTER">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
            </Label>
         </top>
         <center>
            <VBox prefHeight="360.0" prefWidth="660.0" spacing="15.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="161.0" prefWidth="570.0" spacing="20.0">
                     <children>
                        <GridPane prefHeight="191.0" prefWidth="334.0">
                          <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="104.4" />
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="209.0" minWidth="10.0" prefWidth="187.6" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                          </rowConstraints>
                           <children>
                              <Label text="Nombre:">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Categoría:" GridPane.rowIndex="1">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Precio:" GridPane.rowIndex="2">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="1">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font></TextField>
                              <TextField fx:id="txtCategoria" promptText="Categoría" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font></TextField>
                              <TextField fx:id="txtPrecio" prefHeight="26.0" prefWidth="199.0" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font></TextField>
                              <Label text="Fecha de ingreso:" GridPane.rowIndex="3">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font>
                              </Label>
                              <DatePicker fx:id="dtpFecha" prefHeight="26.0" prefWidth="186.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                 <children>
                                    <Button fx:id="btnAgregar" mnemonicParsing="false" text="Agregar">
                                       <font>
                                          <Font name="Times New Roman" size="12.0" />
                                       </font>
                                    </Button>
                                    <Button fx:id="btnActualizar" mnemonicParsing="false" text="Actualizar">
                                       <font>
                                          <Font name="Times New Roman" size="12.0" />
                                       </font>
                                    </Button>
                                    <Button fx:id="btnLimpiar" mnemonicParsing="false" text="Limpiar">
                                       <font>
                                          <Font name="Times New Roman" size="12.0" />
                                       </font>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Imagen del producto">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font>
                              </Label>
                              <ImageView fx:id="imgImagen" fitHeight="150.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" />
                              <Button fx:id="btnSeleccionar" mnemonicParsing="false" text="Seleccionar imagen">
                                 <font>
                                    <Font name="Times New Roman" size="14.0" />
                                 </font></Button>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Line endX="100.0" startX="-660.5" stroke="#b1afaf" />
                  <Label text="Productos Registrados">
                     <font>
                        <Font name="Times New Roman" size="18.0" />
                     </font>
                  </Label>
                  <TableView prefHeight="200.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="colID" prefWidth="75.0" text="ID" />
                      <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
                        <TableColumn fx:id="colFecha" prefWidth="75.0" text="Fecha de Ingreso" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
